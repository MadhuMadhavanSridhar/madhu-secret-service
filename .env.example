# Copy to .env and set a real value. Only guards the internal compose network.
REDIS_PASSWORD=replace-with-a-long-random-string

# Load generator or harness address range that should never be rate limited.
# RATE_LIMIT_EXEMPT_CIDRS=172.18.0.0/16

# Reverse proxy peers allowed to set X-Forwarded-For. Leave empty when exposed directly.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8
